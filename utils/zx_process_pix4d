    images = [
        f for f in os.listdir(in_dir) if f.lower().endswith((".png", ".jpg", ".jpeg"))
    ]

    print(f"Preprocessing {len(images)} images...")
    from PIL import Image

    for filename in tqdm(images, desc="Capture Dataset"):
        input_path = os.path.join(in_dir, filename)
        base_name = os.path.splitext(filename)[0]
        output_path = os.path.join(out_dir, f"{base_name}.png")
        search_window = 21
        block_size = 7
        img = cv2.imread(input_path)
        h, w = img.shape[:2]
        exif_bytes = None

        try:
            exif_dict = piexif.load(input_path)
            if exif_dict:
                exif_bytes = piexif.dump(exif_dict)
        except Exception as e:
            pass

        if EXPERIMENTAL_DENOISE:
            img = cv2.fastNlMeansDenoisingColored(
                src=img,
                dst=None,
                h=EXPERIMENTAL_DENOISE_STRENGTH,
                hColor=EXPERIMENTAL_DENOISE_STRENGTH,
                templateWindowSize=block_size,
                searchWindowSize=search_window,
            )
        if STAGE_DOWNSCALE != -1 and h > STAGE_DOWNSCALE:
            aspect_ratio = w / h
            new_width = int(STAGE_DOWNSCALE * aspect_ratio)
            img = cv2.resize(
                img, (new_width, STAGE_DOWNSCALE), interpolation=cv2.INTER_AREA
            )

        rgb_data = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
        pil_img = Image.fromarray(rgb_data)

        if exif_dict:
            if "0th" in exif_dict:
                exif_dict["0th"][piexif.ImageIFD.ImageWidth] = w
                exif_dict["0th"][piexif.ImageIFD.ImageLength] = h
            if "Exif" in exif_dict:
                exif_dict["Exif"][piexif.ExifIFD.PixelXDimension] = w
                exif_dict["Exif"][piexif.ExifIFD.PixelYDimension] = h

            exif_bytes = piexif.dump(exif_dict)
            pil_img.save(output_path, format="PNG", exif=exif_bytes)
        else:
            pil_img.save(output_path, format="PNG")
    profilerStage("Denoising & Downscaling")
