                "--output_type",
                "BIN",
            ]
        )
        subprocess.run(["sh", "-c", f"rm {pfile("colmap/sparse/0/*.txt")}"])
        profilerStage("AR Sparse Setup")

        print("Step 3c: Triangulating points...")
        subprocess.run(
            [
                "colmap",
                "point_triangulator",
                "--database_path",
                db_path,
                "--image_path",
                images_dir,
                "--input_path",
                pfile("colmap/sparse/0"),
                "--output_path",
                pfile("colmap/sparse/0"),
                "--Mapper.num_threads",
                "-1",
                "--Mapper.ba_use_gpu",
                "1",
                "--Mapper.ba_local_backend",
                EXPERIMENTAL_SOLVER_BACKEND,
                "--Mapper.ba_global_backend",
                EXPERIMENTAL_SOLVER_BACKEND,
                "--clear_points",
                "1",
                "--Mapper.tri_complete_max_reproj_error",
                str(AR_MAX_REPROJECTION_ERROR),
                "--Mapper.tri_merge_max_reproj_error",
                str(AR_MAX_REPROJECTION_ERROR),
            ]
        )

        profilerStage("AR Initial Triangulation")

        for loop in range(EXPERIMENTAL_AR_ITERS):
            print(
                f"Step 3di [{loop + 1}/{EXPERIMENTAL_AR_ITERS}]: Refining positions and rotations (Bundle Adjustment)..."
            )
            late_stage_feature = (
                "1" if loop > ((EXPERIMENTAL_AR_ITERS // 2) - 1) else "0"
            )
            subprocess.run(
                [
                    "colmap",
                    "bundle_adjuster",
                    "--input_path",
                    pfile("colmap/sparse/0"),
                    "--output_path",
                    pfile("colmap/sparse/0"),
                    "--BundleAdjustment.refine_focal_length",
                    late_stage_feature,
                    "--BundleAdjustment.refine_principal_point",
                    "0",
                    "--BundleAdjustment.refine_extra_params",
                    late_stage_feature,
                    "--BundleAdjustment.refine_rig_from_world",
                    "1",
                    "--BundleAdjustment.refine_sensor_from_rig",
                    "1",
                    "--BundleAdjustment.refine_points3D",
                    "1",
                    "--BundleAdjustmentCeres.max_num_iterations",
                    str(SOLVER_ITERATION_CAP),
                    "--BundleAdjustmentCaspar.solver_iter_max",
                    str(SOLVER_ITERATION_CAP),
                    "--BundleAdjustment.backend",
                    EXPERIMENTAL_SOLVER_BACKEND,
                    "--BundleAdjustmentCeres.use_gpu",
                    "1",
                    "--BundleAdjustment.min_track_length",
                    "3",
                ]
            )

            if loop < EXPERIMENTAL_AR_ITERS - 1:
                curr_max_error = f"{(AR_MAX_REPROJECTION_ERROR / (loop + 1)):.2f}"
                print(
                    f"Step 3dii [{loop + 1}/{EXPERIMENTAL_AR_ITERS}]: Filtering outlier points (max reproj error: {curr_max_error}px)..."
                )
                quietRun(
                    [
                        "colmap",
                        "point_filtering",
                        "--input_path",
                        pfile("colmap/sparse/0"),
                        "--output_path",
                        pfile("colmap/sparse/0"),
                        "--max_reproj_error",
                        curr_max_error,
                        "--min_track_len",
                        "3",
                    ]
                )

                if EXPERIMENTAL_IMFILTER:
                    print(
                        f"Step 3dii-b [{loop + 1}/{EXPERIMENTAL_AR_ITERS}]: Filtering outlier images (max reproj error: {curr_max_error}px)..."
                    )
                    quietRun(
                        [
                            "colmap",
                            "image_filterer",
                            "--input_path",
                            pfile("colmap/sparse/0"),
                            "--output_path",
                            pfile("colmap/sparse/0"),
                            "--min_num_observations",
                            "10",
                            "--min_focal_length_ratio",
                            "0.1",
                            "--max_focal_length_ratio",
                            "10.0",
                        ]
                    )

                print(
                    f"Step 3diii [{loop + 1}/{EXPERIMENTAL_AR_ITERS}]: Re-triangulating points with optimized poses..."
                )
                subprocess.run(
                    [
                        "colmap",
                        "point_triangulator",
                        "--database_path",
                        db_path,
                        "--image_path",
                        images_dir,
                        "--input_path",
                        pfile("colmap/sparse/0"),
                        "--output_path",
                        pfile("colmap/sparse/0"),
                        "--Mapper.num_threads",
                        "-1",
                        "--Mapper.ba_use_gpu",
                        "1",
                        "--Mapper.ba_local_backend",
                        EXPERIMENTAL_SOLVER_BACKEND,
                        "--Mapper.ba_global_backend",
                        EXPERIMENTAL_SOLVER_BACKEND,
                        "--Mapper.tri_complete_max_reproj_error",
                        curr_max_error,
                        "--Mapper.tri_merge_max_reproj_error",
                        curr_max_error,
                    ]
                )
            profilerStage(f"AR Iteration {loop+1}")
    elif EXPERIMENTAL_GLOMAP:
        print("Step 3a: Calibrating view graph...")
        subprocess.run(["colmap", "view_graph_calibrator", "--database_path", db_path])
        profilerStage("View Graph Calibration")

        print("Step 3b: Global reconstruction...")
        subprocess.run(
            [
                "colmap",
                "global_mapper",
                "--database_path",
                db_path,
                "--image_path",
                images_dir,
                "--output_path",
                pfile("colmap/sparse"),
                "--GlobalMapper.num_threads",
                "-1",
                "--GlobalMapper.track_min_num_views_per_track",
                "6",
                "--GlobalMapper.ba_ceres_use_gpu",
                "1",
                "--GlobalMapper.gp_use_gpu",
                "1",
                "--GlobalMapper.ba_backend",
                EXPERIMENTAL_SOLVER_BACKEND,
                "--GlobalMapper.ba_ceres_max_num_iterations",
                str(SOLVER_ITERATION_CAP),
            ]
        )
        profilerStage("Global Mapper")
    else:
        print("Step 3: Pose prior mapper...")
        subprocess.run(
            [
                "colmap",
                "pose_prior_mapper",
                "--database_path",
                db_path,
                "--image_path",
                images_dir,
                "--output_path",
                pfile("colmap/sparse"),
                "--Mapper.num_threads",
                "-1",
                "--Mapper.filter_max_reproj_error",
                "1.5",
                "--Mapper.min_num_matches",
                "35",
                "--Mapper.max_reg_trials",
                "1",
                "--Mapper.ba_global_backend",
                "CERES",
                "--Mapper.ba_local_backend",
                "CERES",
                "--Mapper.ba_use_gpu",
                "1",
            ]
        )
        profilerStage("Pose Prior Mapper")

    print("Step 4a: Model alignment...")
    subprocess.run(
        [
            "colmap",
            "model_aligner",
            "--input_path",
            pfile("colmap/sparse/0"),
            "--output_path",
            pfile("colmap/sparse/0"),
            pfile("colmap/sparse/0"),
            pfile("colmap/sparse/0"),
            "--ref_images_path",
            priors_file,
            "--ref_is_gps",
            "0",
            "--alignment_type",
            "custom",
            # "--robust_alignment", "1",
            "--alignment_max_error",
            "1.5",
        ]
    )
    profilerStage("Model Alignment")

    print("Step 4b: Model orientation alignment...")
    subprocess.run(
        [
            "colmap",
            "model_orientation_aligner",
            "--input_path",
            pfile("colmap/sparse/0"),
            "--output_path",
            pfile("colmap/sparse/0"),
            "--image_path",
            images_dir,
            "--method",
            "IMAGE-ORIENTATION",
        ]
    )
    profilerStage("Model Orientation Alignment")

print("Shifting back to regular filesystem...")
quietRun(["mv", dest_path, true_dest_path])
profilerStage("Finalising")

print("")
print("[ PROJECT INFO ]")
print(f"Name: {projectMeta["name"]}")
print(f"Trigger Method: {projectMeta["trigger"]["triggerType"]}")
print(f"Distance Covered: {int(projectMeta["distanceTravelled"])}m")
print(f"Frame Count: {projectMeta["initial_image_count"]} images")
print(
    f"Coordinate Space: {projectMeta["locationInformation"]["coordinateSystem"]["name"]}"
)
print("")
print("[ RECONSTRUCTION INFO ]")
if len(sys.argv) > 3:
    print("Flags: ")
    flags = sys.argv[3].lower().strip().split(",")
    for flag in flags:
        print(f"  > {flag}")
else:
    print("Flags: None")

total_duration = times[-1]["stamp"] - init_time
max_stage_name_len = max(len(t["name"]) for t in times)
print("Profiler: ")
for timed_stage in times:
    stage_name = timed_stage["name"]
    duration_secs = timed_stage["time"]
    total_secs = round(duration_secs)
    if total_secs == 0:
        time_str = f"{duration_secs:.2f}s" if duration_secs > 0 else "0s"
    else:
        hours = total_secs // 3600
        minutes = (total_secs % 3600) // 60
        secs = total_secs % 60

        parts = []
        if hours > 0:
            parts.append(f"{hours}h")
        if minutes > 0:
            parts.append(f"{minutes}m")
        if secs > 0:
            parts.append(f"{secs}s")
        time_str = " ".join(parts)
    pct = (duration_secs / total_duration) * 100
    print(f"{stage_name:<{max_stage_name_len}} {time_str:<12} {pct:.1f}%")


print(f"Completed in {int(time.time() - start_time)}s")
