def profilerStage(stage):
    global times
    global recent_time
    stage_time = time.time()
    times.append({"name": stage, "time": stage_time - recent_time, "stamp": stage_time})
    recent_time = stage_time
    sys.stdout.flush()
    sys.stderr.flush()


