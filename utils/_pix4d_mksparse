#!/usr/bin/python3

import sqlite3
import struct
import numpy as np
import pycolmap
import sys


def get_opencv_intrinsics_from_db(db_path):
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()

    cursor.execute("SELECT camera_id, model, width, height, params FROM cameras")
    cameras_data = cursor.fetchall()

    intrinsics_dict = {}

    for camera_id, model_id, width, height, params_blob in cameras_data:
        model_name = pycolmap.CameraModelId(model_id).name

        num_params = len(params_blob) // 8
        params = struct.unpack(f"<{num_params}d", params_blob)

        print(f"Camera ID: {camera_id} | Model: {model_name} | Size: {width}x{height}")

        if model_name == "OPENCV":
            fx, fy, cx, cy, k1, k2, p1, p2 = params
            K = np.array([[fx, 0, cx], [0, fy, cy], [0, 0, 1]], dtype=np.float64)

            D = np.array([k1, k2, p1, p2], dtype=np.float64)

            intrinsics_dict[camera_id] = {
                "K": K,
                "D": D,
                "width": width,
                "height": height,
                "params": [fx, fy, cx, cy, k1, k2, p1, p2],
                "model_name": model_name,
            }
        elif model_name == "SIMPLE_RADIAL":
            f, cx, cy, k = params

            K = np.array([[f, 0, cx], [0, f, cy], [0, 0, 1]], dtype=np.float64)

            D = np.array([k, 0.0, 0.0, 0.0], dtype=np.float64)

            intrinsics_dict[camera_id] = {
                "model_name": model_name,
                "K": K,
                "D": D,
                "width": width,
                "height": height,
                "params": list(params),
            }
        else:
            print(f"Unsupported camera model: {model_name}")
            sys.exit(1)

    conn.close()
    if not 1 in intrinsics_dict:
        print("No camera with ID of 1!")
        sys.exit(1)
    return intrinsics_dict


if len(sys.argv) < 3:
    print(
        "Usage: _pix4d_mksparse experiment/colmap/database.db experiment/colmap/sparse/0"
    )
    sys.exit(1)

db_path = sys.argv[1]
base_dir_path = sys.argv[2]
intrinsics = get_opencv_intrinsics_from_db(db_path)

root_camera = intrinsics[1]
with open(base_dir_path + "/points3D.txt", "w") as p3d:
    p3d.write("# autogenerated\n")
    p3d.close()

with open(base_dir_path + "/cameras.txt", "w") as cams:
    cams.write("# autogenerated\n")
    cams.write(
        f"1 {root_camera["model_name"]} {root_camera["width"]} {root_camera["height"]} {" ".join(map(lambda x: str(x), root_camera["params"]))}"
    )
    cams.close()

print("Manually retrieved camera intrinsics.")
