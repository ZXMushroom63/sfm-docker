                "30",
            ]
            + extraMatchingFlags
        )
        profilerStage("VocabTree Matching")

    if EXPERIMENTAL_AR:
        print("Step 3a: Generating initial sparse model from AR priors...")
        with open(pfile("colmap/sparse/0/points3D.txt"), "w") as pf:
            pf.write("")
            pf.close()
        with open(pfile("colmap/sparse/0/cameras.txt"), "w") as pf:
            pf.write("")
            pf.close()

        print("Step 3b: Extracting camera intrinsics...")
        subprocess.run(
            [
                "/NERFSTUDIO/utils/_pix4d_mksparse",
                db_path,
                pfile("colmap/sparse/0"),
            ]
        )
        subprocess.run(
            [
                "colmap",
                "model_converter",
                "--input_path",
                pfile("colmap/sparse/0"),
                "--output_path",
                pfile("colmap/sparse/0"),
                "--output_type",
                "BIN",
            ]
        )
        subprocess.run(["sh", "-c", f"rm {pfile("colmap/sparse/0/*.txt")}"])
        profilerStage("AR Sparse Setup")

        print("Step 3c: Triangulating points...")
        subprocess.run(
            [
                "colmap",
                "point_triangulator",
                "--database_path",
                db_path,
                "--image_path",
                images_dir,
                "--input_path",
                pfile("colmap/sparse/0"),
                "--output_path",
                pfile("colmap/sparse/0"),
                "--Mapper.num_threads",
                "-1",
                "--Mapper.ba_use_gpu",
                "1",
                "--Mapper.ba_local_backend",
                EXPERIMENTAL_SOLVER_BACKEND,
                "--Mapper.ba_global_backend",
                EXPERIMENTAL_SOLVER_BACKEND,
                "--clear_points",
                "1",
                "--Mapper.tri_complete_max_reproj_error",
                str(AR_MAX_REPROJECTION_ERROR),
                "--Mapper.tri_merge_max_reproj_error",
                str(AR_MAX_REPROJECTION_ERROR),
