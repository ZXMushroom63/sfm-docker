#!/usr/bin/python3

import sys
import pathlib
import os
import json
import csv
import subprocess
import time
import math
from pathlib import Path
from concurrent.futures import ProcessPoolExecutor
import numpy as np
from scipy.spatial.transform import Rotation as R

EXPERIMENTAL_GLOMAP = False
EXPERIMENTAL_ALIKED = False
EXPERIMENTAL_NOBLUR = False
EXPERIMENTAL_AR = False
EXPERIMENTAL_AR_ITERS = 3
EXPERIMENTAL_NOBLUR_THRESH = 18000
SOLVER_ITERATION_CAP = 200

def quietRun(args):
    subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if len(sys.argv) < 3:
    print(
        "Usage: zx_process_pix4d <path/to/pix4d_raw_exported.zip> <path/to/dest> [global,noblur=18000,aliked,ar=3,solver=200]\n",
        file=sys.stderr,
    )
    print(
        "Example: zx_process_pix4d vid/simple_demo_pix4d.zip experiment/ global\n"
        + "Example: zx_process_pix4d vid/simple_demo_pix4d.zip experiment/ noblur=18000,global\n"
        + "Example: zx_process_pix4d vid/simple_demo_pix4d.zip experiment/\n"
        + "Example: zx_process_pix4d vid/simple_demo_pix4d.zip experiment/ ar=3,noblur,solver=300\n",
        file=sys.stderr,
    )
    print(
        "Built for pix4Dcatch v1.30.0, using a no-account patch and not using RTK\n",
        file=sys.stderr,
    )
    print(
        "Extraflags: \n"
        + "  global: Use GLOBAL_MAPPER mapping algorithm, which is much faster than POSE_MAPPER, but may be less accurate\n"
        + "  noblur=900: Filter images by laplacian variance, to remove blurred images.\n"
        + "  aliked: Use ALIKED_N16ROT for feature extraction and matching instead of SIFT, which does better on less-detailed surfaces. Requires 'zx_download_assets onnx' to run properly.\n"
        + "  ar: Skip the mapping stage entirely, and instead use AR positions and refine those. Value is equal to the number of adjustment and retriangulation iterations. recommended to use in combination with raising the Ceres solver iteration cap. Incompatible with ALIKED features, for some reason.\n",
        + "  solver=200: Maximum number of solver iterations for the Ceres / Caspar GPU solvers\n",
        file=sys.stderr,
    )
    sys.exit(1)


zip_path = str(pathlib.Path(sys.argv[1]).absolute())
dest_path = str(pathlib.Path(sys.argv[2]).absolute())

if len(sys.argv) > 3:
    flags = sys.argv[3].lower().strip().split(",")
    if "global" in flags:
        EXPERIMENTAL_GLOMAP = True
        print("Enabling GLOBAL_MAPPER mapper")
    if "aliked" in flags:
        EXPERIMENTAL_ALIKED = True
        print("Enabling ALIKED_N16ROT features")
    for flag in flags:
        if flag.startswith("noblur"):
            EXPERIMENTAL_NOBLUR = True
            if flag.startswith("noblur="):
                EXPERIMENTAL_NOBLUR_THRESH = int(flag.replace("noblur=", ""))
                print(
                    f"Enabling blur detection with custom threshold of lv={EXPERIMENTAL_NOBLUR_THRESH}"
                )
            else:
                print(
                    f"Enabling blur detection with default threshold of lv={EXPERIMENTAL_NOBLUR_THRESH}"
                )
        if flag.startswith("ar"):
            EXPERIMENTAL_AR = True
            if flag.startswith("ar="):
                EXPERIMENTAL_AR_ITERS = int(flag.replace("ar=", ""))
            print(f"Using AR priors, with {EXPERIMENTAL_AR_ITERS} iterations")
        if flag.startswith("solver="):
            SOLVER_ITERATION_CAP = int(flag.replace("solver=", ""))
            print(f"Setting Ceres solver iteration cap to {SOLVER_ITERATION_CAP}")

if EXPERIMENTAL_AR and EXPERIMENTAL_ALIKED:
    print("ALIKED features cannot be used with point_triangulator, and as such don't work on the AR pipeline!")
    sys.exit(1)

def pfile(strPath):
    return dest_path + "/" + strPath


start_time = time.time()

print("Clearing previous directory...")
quietRun(["rm", "-r", dest_path])

time.sleep(0.1)

print("Extracting pix4d data...")
quietRun(["unzip", zip_path, "-d", dest_path, "-x", "*Confidence_*", "-x", "*DepthMap_*"])

time.sleep(1)

subdir = str(
    [x for x in pathlib.Path(sys.argv[2]).absolute().iterdir() if x.is_dir()][0]
)
print(f"Using directory: {subdir}")
quietRun(["mv", subdir, dest_path + "/pixdata"])

projectMeta = None
with open(pfile("pixdata/projectMetadata.json"), "r") as f:
    projectMeta = json.load(f)

if projectMeta["locationInformation"]["coordinateSystem"]["name"] != "WGS 84":
    print("Expected WGS 84 coordinate system!")
    sys.exit(1)

AR_positionData = {}
xy_accuracy = 0
z_accuracy = 0

useCorrectedData = False

with open(pfile("pixdata/_gps/_locations_gps_ar_corrected.csv"), "r") as f:
    if len(f.readlines()) > 2:
        useCorrectedData = True
        print(
            "Your capture contains error-corrected data, using that instead of raw AR"
        )

with open(
    pfile(
        "pixdata/_gps/_locations_gps_ar_corrected.csv"
        if useCorrectedData
        else "pixdata/_gps/_all_locations.csv"
    ),
    "r",
) as f:  # pixdata/_gps/_all_locations.csv
    reader = csv.reader(f)

    header = next(reader)

    IDX_IMAGE = header.index("image")
    IDX_ROLL = header.index("roll")
    IDX_PITCH = header.index("pitch")
    IDX_YAW = header.index("yaw")
    IDX_LAT = header.index("latitude")
    IDX_LON = header.index("longitude")
    IDX_ALT = header.index("altitude")
    IDX_XY = header.index("xyAccuracy")
    IDX_Z = header.index("zAccuracy")

    if not useCorrectedData:
        marker = []
        while not (len(marker) == 1 and marker[0].lower().endswith("ar")):
            marker = next(reader)

    for row in reader:
        if row[0].strip().startswith("//"):
            break
        AR_positionData[row[IDX_IMAGE]] = {
            "roll": float(row[IDX_ROLL]),
            "pitch": float(row[IDX_PITCH]),
            "yaw": float(row[IDX_YAW]),
            "latitude": float(row[IDX_LAT]),
            "longitude": float(row[IDX_LON]),
            "altitude": float(row[IDX_ALT]),
            "img": row[IDX_IMAGE],
        }
        xy_accuracy = max(xy_accuracy, float(row[IDX_XY]))
        z_accuracy = max(z_accuracy, float(row[IDX_Z]))

quietRun(["mkdir", "-p", pfile("images")])

print("Moving frames...")
quietRun(["sh", "-c", f"mv {pfile("pixdata/Image_*")} {pfile("images/")}"])


def process_blur_batch(batch_paths, threshold):
    if not batch_paths:
        return []

    cmd = ["zx_find_blurry.py", str(threshold)] + [str(p) for p in batch_paths]

    result = subprocess.run(cmd, capture_output=True, text=True, check=True)
    return [
        line for line in result.stdout.replace(" ", "\n").splitlines() if line.strip()
    ]


if EXPERIMENTAL_NOBLUR:
    parallel = os.cpu_count() - 2
    with ProcessPoolExecutor(max_workers=parallel) as executor:
        root = pfile("images/")
        images = [str(img) for img in Path(root).iterdir() if img.is_file()]
        images.sort()
        print(
            f"Scanning a total of {len(images)} frames for blurring with thresh={EXPERIMENTAL_NOBLUR_THRESH}"
        )
        arg_list = [[[], EXPERIMENTAL_NOBLUR_THRESH] for _ in range(parallel)]
        allocator = 0
        for path in images:
            arg_list[allocator][0].append(path)
            allocator = (allocator + 1) % parallel

        futures = [executor.submit(process_blur_batch, *args) for args in arg_list]
        results = [future.result() for future in futures]
        blurry_count = 0
        for result in results:
            blurry_count += len(result)

        print(
            f"Found that {int(blurry_count / len(images) * 100)}% frames were blurry ({blurry_count} frames)"
        )
        if blurry_count >= len(images) / 2:
            print("Walk slower, or change the blurriness threshold.")
            time.sleep(1)
        if blurry_count >= len(images):
            print("Change the blurriness threshold!")
            exit(1)
        print("Purging blurry frames...")
        flattenedList = []
        for result in results:
            for file in result:
                flattenedList.append(file.strip())
        flattenedList.sort()
        quietRun(["rm"] + flattenedList)

print("Preparing COLMAP workspace and spatial priors...")
quietRun(["mkdir", "-p", pfile("colmap")])
quietRun(["mkdir", "-p", pfile("colmap/sparse/0")])

db_path = pfile("colmap/database.db")
images_dir = pfile("images")
priors_file = pfile("colmap/spatial_priors.txt")

first_img = list(AR_positionData.keys())[0]
ref_lat = AR_positionData[first_img]["latitude"]
ref_lon = AR_positionData[first_img]["longitude"]
ref_alt = AR_positionData[first_img]["altitude"]

R_a = 6378137.0
with open(priors_file, "w") as pf:
    for img_name, data in AR_positionData.items():
        if not Path(pfile("images/" + data["img"])).is_file():
            continue
        dlat = math.radians(data["latitude"] - ref_lat)
        dlon = math.radians(data["longitude"] - ref_lon)
        x = dlon * R_a * math.cos(math.radians(ref_lat))
        y = dlat * R_a
        z = data["altitude"] - ref_alt
        roll = data["roll"]
        pitch = data["pitch"]
        yaw = data["yaw"]
        pf.write(f"{img_name} {x} {y} {z}\n")

if EXPERIMENTAL_AR:
    with open(pfile("colmap/sparse/0/images.txt"), "w") as img:
        frame_index = 1
        for img_name, data in AR_positionData.items():
            if not Path(pfile("images/" + data["img"])).is_file():
                continue
            dlat = math.radians(data["latitude"] - ref_lat)
            dlon = math.radians(data["longitude"] - ref_lon)
            x = dlon * R_a * math.cos(math.radians(ref_lat))
            y = dlat * R_a
            z = data["altitude"] - ref_alt
            camera_center = np.array([x, y, z], dtype=np.float64)
            yaw = math.radians(data["yaw"])
            pitch = math.radians(data["pitch"])
            roll = math.radians(data["roll"])
            r_yaw = R.from_rotvec([0, 0, -yaw])
            r_pitch = R.from_rotvec([pitch, 0, 0])
            r_roll = R.from_rotvec([0, roll, 0])
            r_device_to_world = r_yaw * r_pitch * r_roll
            R_body_to_colmap_cam = np.array([[1, 0, 0], [0, -1, 0], [0, 0, -1]])
            r_body_to_colmap = R.from_matrix(R_body_to_colmap_cam)
            r_colmap_cam_to_world = r_device_to_world * r_body_to_colmap
            r_world_to_colmap = r_colmap_cam_to_world.inv()
            R_mat = r_world_to_colmap.as_matrix()
            tvec = -R_mat @ camera_center
            q = r_world_to_colmap.as_quat()
            qx, qy, qz, qw = q[0], q[1], q[2], q[3]
            img.write(
                f"{frame_index} {qw} {qx} {qy} {qz} {tvec[0]} {tvec[1]} {tvec[2]} 1 {img_name}\n\n"  # pfile('images/' + img_name)
            )
            frame_index += 1

time.sleep(3)

extraExtractionFlags = []
extraMatchingFlags = ["--FeatureMatching.guided_matching", "1"]
if EXPERIMENTAL_ALIKED:
    extraExtractionFlags += [
        "--FeatureExtraction.type",
        "ALIKED_N16ROT",
        "--AlikedExtraction.n16rot_model_path",
        "/NERFSTUDIO/weights/aliked-n16rot.onnx",
    ]
    extraMatchingFlags = [
        "--FeatureMatching.type",
        "ALIKED_LIGHTGLUE",
        "--AlikedMatching.lightglue_model_path",
        "/NERFSTUDIO/weights/aliked-lightglue.onnx",
    ]

print("Step 1: Extracting features...")

subprocess.run(
    [
        "colmap",
        "feature_extractor",
        "--database_path",
        db_path,
        "--image_path",
        images_dir,
        "--ImageReader.single_camera",
        "1",
        "--ImageReader.camera_model",
        "OPENCV",
        "--FeatureExtraction.use_gpu",
        "1",
        "--SiftExtraction.max_num_features",
        "8192",
        "--FeatureExtraction.num_threads",
        "-1",
    ]
    + extraExtractionFlags
)

print("Step 2a: Sequential matching...")
subprocess.run(
    [
        "colmap",
        "sequential_matcher",
        "--database_path",
        db_path,
        "--SequentialMatching.overlap",
        "15",
        "--FeatureMatching.use_gpu",
        "1",
    ]
    + extraMatchingFlags
)

print("Step 2b: Spatial matching...")
subprocess.run(
    [
        "colmap",
        "spatial_matcher",
        "--database_path",
        db_path,
        "--SpatialMatching.max_num_neighbors",
        "10",
        "--SpatialMatching.max_distance",
        "5",  # radius limit (5 meters)
        "--FeatureMatching.use_gpu",
        "1",
    ]
    + extraMatchingFlags
)

if EXPERIMENTAL_AR:
    print("Step 3a: Generating initial sparse model from AR priors...")
    with open(pfile("colmap/sparse/0/points3D.txt"), "w") as pf:
        pf.write("")
        pf.close()
    with open(pfile("colmap/sparse/0/cameras.txt"), "w") as pf:
        pf.write("")
        pf.close()

    print("Step 3b: Extracting camera intrinsics...")
    subprocess.run(
        [
            "_pix4d_mksparse",
            db_path,
            pfile("colmap/sparse/0"),
        ]
    )
    subprocess.run(
        [
            "colmap",
            "model_converter",
            "--input_path", pfile("colmap/sparse/0"),
            "--output_path", pfile("colmap/sparse/0"),
            "--output_type", "BIN"
        ]
    )
    subprocess.run(["sh", "-c", f"rm {pfile("colmap/sparse/0/*.txt")}"])
    

    print("Step 3c: Triangulating points...")
    subprocess.run(
        [
            "colmap",
            "point_triangulator",
            "--database_path",
            db_path,
            "--image_path",
            images_dir,
            "--input_path",
            pfile("colmap/sparse/0"),
            "--output_path",
            pfile("colmap/sparse/0"),
            "--Mapper.num_threads",
            "-1",
            "--clear_points", "1"
        ]
    )

    MAX_REPROJECTION_ERROR = 4.0

    for loop in range(EXPERIMENTAL_AR_ITERS):
        print(
            f"Step 3di [{loop + 1}/{EXPERIMENTAL_AR_ITERS}]: Refining positions and rotations (Bundle Adjustment)..."
        )
        subprocess.run(
            [
                "colmap",
                "bundle_adjuster",
                "--input_path",
                pfile("colmap/sparse/0"),
                "--output_path",
                pfile("colmap/sparse/0"),
                "--BundleAdjustment.refine_focal_length",
                "1",
                "--BundleAdjustment.refine_principal_point",
                "0",
                "--BundleAdjustment.refine_extra_params",
                "1",
                "--BundleAdjustment.refine_rig_from_world",
                "1",
                "--BundleAdjustment.refine_sensor_from_rig",
                "1",
                "--BundleAdjustment.refine_points3D",
                "1",
                "--BundleAdjustmentCeres.max_num_iterations",
                str(SOLVER_ITERATION_CAP),
                "--BundleAdjustmentCaspar.solver_iter_max", str(SOLVER_ITERATION_CAP),
                "--BundleAdjustmentCeres.use_gpu",
                "1",
                "--BundleAdjustment.min_track_length",
                "3",
            ]
        )

        if loop < EXPERIMENTAL_AR_ITERS - 1:
            curr_max_error = f"{(4.0 / (loop + 1)):.2f}"
            print(
                f"Step 3dii [{loop + 1}/{EXPERIMENTAL_AR_ITERS}]: Filtering outlier points (max reproj error: {curr_max_error}px)..."
            )
            quietRun(
                [
                    "colmap",
                    "point_filtering",
                    "--input_path",
                    pfile("colmap/sparse/0"),
                    "--output_path",
                    pfile("colmap/sparse/0"),
                    "--max_reproj_error",
                    curr_max_error,
                    "--min_track_len",
                    "3",
                ]
            )

            print(
                f"Step 3diii [{loop + 1}/{EXPERIMENTAL_AR_ITERS}]: Re-triangulating points with optimized poses..."
            )
            subprocess.run(
                [
                    "colmap",
                    "point_triangulator",
                    "--database_path",
                    db_path,
                    "--image_path",
                    images_dir,
                    "--input_path",
                    pfile("colmap/sparse/0"),
                    "--output_path",
                    pfile("colmap/sparse/0"),
                    "--Mapper.num_threads",
                    "-1",
                    "--Mapper.ba_use_gpu", "1"
                ]
            )
elif EXPERIMENTAL_GLOMAP:
    print("Step 3a: Calibrating view graph...")
    subprocess.run(["colmap", "view_graph_calibrator", "--database_path", db_path])

    print("Step 3b: Global reconstruction...")
    subprocess.run(
        [
            "colmap",
            "global_mapper",
            "--database_path",
            db_path,
            "--image_path",
            images_dir,
            "--output_path",
            pfile("colmap/sparse"),
            "--GlobalMapper.num_threads",
            "-1",
            "--GlobalMapper.track_min_num_views_per_track",
            "6",
            "--GlobalMapper.ba_ceres_max_num_iterations", str(SOLVER_ITERATION_CAP)
        ]
    )
else:
    print("Step 3: Pose prior mapper...")
    subprocess.run(
        [
            "colmap",
            "pose_prior_mapper",
            "--database_path",
            db_path,
            "--image_path",
            images_dir,
            "--output_path",
            pfile("colmap/sparse"),
            "--Mapper.num_threads",
            "-1",
            "--Mapper.filter_max_reproj_error",
            "1.5",
            "--Mapper.min_num_matches",
            "35",
            "--Mapper.max_reg_trials",
            "1",
        ]
    )

print("Step 4a: Model alignment...")
subprocess.run(
    [
        "colmap",
        "model_aligner",
        "--input_path",
        pfile("colmap/sparse/0"),
        "--output_path",
        pfile("colmap/sparse/0"),
        pfile("colmap/sparse/0"),
        pfile("colmap/sparse/0"),
        "--ref_images_path",
        priors_file,
        "--ref_is_gps",
        "0",
        "--alignment_type",
        "custom",
        # "--robust_alignment", "1",
        "--alignment_max_error",
        "1.5",
    ]
)

print("Step 4b: Model orientation alignment...")
subprocess.run(
    [
        "colmap",
        "model_orientation_aligner",
        "--input_path",
        pfile("colmap/sparse/0"),
        "--output_path",
        pfile("colmap/sparse/0"),
        "--image_path",
        images_dir,
        "--method",
        "IMAGE-ORIENTATION",
    ]
)


