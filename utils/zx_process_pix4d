def registerOnnxModel(easyName: str, profile: dict):
    ONNX_SETUPDB[easyName] = profile
    prereqs = []
    for k in profile.keys():
        v = profile[k]
        t = type(v)
        if t == str:
            if v.startswith("/"):
                profile[k] = "/NERFSTUDIO/weights" + v
                prereqs.append(profile[k])
        if t == list:
            newList = []
            for i in v:
                if i.startswith("/"):
                    newList.append("/NERFSTUDIO/weights" + i)
                    prereqs.append(newList[-1])
                else:
                    newList.append(i)
            profile[k] = newList
    profile["prereqs"] = prereqs
    print(f"Registered ONNX feature model: {easyName}")


